# ─── Environment & Secrets ─────────────────────────────────
.env
.env.*
!.env.example

# ─── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
env3.*

# Python tools
.mypy_cache/
.pytest_cache/
.coverage*
coverage.xml
htmlcov/
.ruff_cache/
.tox/
Pipfile.lock

# ─── Database ──────────────────────────────────────────────
*.db
*.sqlite3
*.sqlite

# ─── Node / Frontend ──────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ─── Build & Dist ─────────────────────────────────────────
dist/
build/
*.egg-info/

# ─── IDE & Editor ─────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.*.sw?

# ─── OS ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Logs ─────────────────────────────────────────────────
*.log
log.txt

# ─── Misc ─────────────────────────────────────────────────
.cache/
.netlify/
.ipynb_checkpoints/
.codspeed
*.zip
test.db
test_crm.db